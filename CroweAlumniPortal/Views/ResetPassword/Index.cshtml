@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Reset Password</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/assets/img/fav Crowe.png" rel="icon">
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/css/Crowe.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet">
    <link href="~/assets/css/CustomCss.css" rel="stylesheet" />
    <link href="~/assets/css/sweet-alert.css" rel="stylesheet" />
</head>
<body>
    <main id="main" class="main">

        <div class="container">
            <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex justify-content-center">
                                <a class="Crowelogo align-items-center d-flex">
                                    <img src="~/assets/img/Crowe.png" alt="HRMS">
                                </a>
                            </div><!-- End Logo -->

                            <div class="card mb-3" style="margin-bottom:0 !important; padding:18px !important;">
                                <!-- size thora bara -->
                                <div class="card-body" style="padding:12px !important;">
                                    <!-- body padding adjust -->
                                    <div class="pt-1 pb-2" style="margin-bottom:6px !important;">
                                        <!-- thora kam gap -->
                                        <h5 class="card-title text-center pb-0 fs-4" style="margin-bottom:4px !important;">Forget Password</h5>
                                        <p class="text-center small" style="margin-bottom:6px !important;">Enter your email to get a password reset link</p>
                                    </div>
                                    <form id="resetPasswordForm">

                                        <input type="hidden" id="token" value="@Context.Request.Query["token"]" />
                                        <div class="row mb-3">
                                            <div class="col-md-12 mb-3">
                                                <div class="form-group">
                                                    <label for="newPassword" class="alum-label">New Password*</label>
                                                    <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                                                </div>
                                            </div>
                                            <div class="col-md-12 mb-3">
                                                <div class="form-group">
                                                    <label for="confirmPassword" class="alum-label">Confirm Password*</label>
                                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="text-center mt-4">
                                            <button type="submit" class="submit-btn">Submit</button>
                                        </div>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </section>

        </div>

        @* <div class="container" id="form">
            <div class="card mb-3 pt-5">

                <h3 class="text-center mb-5 text-black">Reset Password</h3>

                <form id="resetPasswordForm">
                    <input type="hidden" id="token" />

                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label for="newPassword" class="alum-label">New Password*</label>
                                <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="form-group">
                                <label for="confirmPassword" class="alum-label">Confirm Password*</label>
                                <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <button type="submit" class="submit-btn">Reset Password</button>
                    </div>
                </form>
            </div>
        </div> *@
    </main>

    <script src="~/assets/js/jquery-3.5.1.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/sweet-alert.min.js"></script>
    <script src="~/assets/js/ajax/alumni/resetPassword.js"></script>
</body>
</html>