@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Forget Password</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="~/assets/img/fav Crowe.png" rel="icon">

    <!-- Google Fonts -->
    <link href="https://fonts.gstatic.com" rel="preconnect">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">

    <!-- Template Main CSS File -->
    <link href="~/assets/css/Crowe.css" rel="stylesheet" />
    <link href="~/assets/css/style.css" rel="stylesheet">
    <link href="~/assets/css/CustomCss.css" rel="stylesheet" />
    <link href="~/assets/css/sweet-alert.css" rel="stylesheet" />
</head>
<body>
    <main id="main" class="main">
        <div class="container">
            <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex justify-content-center">
                                <a class="Crowelogo align-items-center d-flex">
                                    <img src="~/assets/img/Crowe.png" alt="HRMS">
                                </a>
                            </div><!-- End Logo -->

                            <div class="card mb-3" style="margin-bottom:0 !important; padding:18px !important;">
                                <!-- size thora bara -->
                                <div class="card-body" style="padding:12px !important;">
                                    <!-- body padding adjust -->
                                    <div class="pt-1 pb-2" style="margin-bottom:6px !important;">
                                        <!-- thora kam gap -->
                                        <h5 class="card-title text-center pb-0 fs-4" style="margin-bottom:4px !important;">Forget Password</h5>
                                        <p class="text-center small" style="margin-bottom:6px !important;">Enter your email to get a password reset link</p>
                                    </div>
                                    <form id="forgetPasswordForm" enctype="multipart/form-data">

                                        <div class="row mb-3">
                                            <div class="col-md-12 mb-3">
                                                <div class="form-group">
                                                    <label for="email" class="alum-label">Email*</label>
                                                    <input type="email" class="form-control" id="email" name="email" required>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="col-12 mb-4">
                                            <button class="btn btn-primary account-btn" type="button" id="btn_Login">
                                                Login
                                            </button>
                                        </div>
                                        <div class="row g-3 needs-validation" id="forgotPasswordForm" style="margin-bottom:0 !important;">
                                            <div class="col-md-6" style="margin-bottom:5px !important;">
                                                <a asp-controller="Home" asp-action="Login" id="forgotPassword"
                                                   style="color:#f7b400; text-decoration:none; font-weight:500;">
                                                   Sign-In
                                                </a>
                                            </div>
                                           
                                        </div>
                                        @* <div class="text-center mt-4">
                                            <button type="submit" class="submit-btn">Submit</button>
                                        </div> *@
                                    </form>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </section>

        </div>
        @* <div class="container" id="form">
            <div class="card mb-3 pt-5">
                <div class="card-body">
                    <h3 class="card-title text-center mb-5 text-black">Forget Password</h3>

                    <form id="forgetPasswordForm" enctype="multipart/form-data">
                  
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3">
                                <div class="form-group">
                                    <label for="email" class="alum-label">Email*</label>
                                    <input type="email" class="form-control" id="email" name="email" required>
                                </div>
                            </div>
                       
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="submit-btn">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div> *@
    </main>

    <!-- Vendor JS Files -->
    <script src="~/assets/js/jquery-3.5.1.js"></script>
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/sweet-alert.min.js"></script>

    <!-- Page JS -->
    <script src="~/assets/js/ajax/alumni/forgetPassword.js"></script>
</body>
</html>
